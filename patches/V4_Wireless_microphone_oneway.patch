diff --git a/drivers/usb/gadget/configfs.c b/drivers/usb/gadget/configfs.c
index 9b32930..cb08fa9 100644
--- a/drivers/usb/gadget/configfs.c
+++ b/drivers/usb/gadget/configfs.c
@@ -580,6 +580,20 @@ static struct usb_function *get_adb_function_from_linked_func(struct gadget_info
 	}
 	return NULL;
 }
+
+/* Keep functions created by ConfigFS in the active configuration when the
+ * Samsung UEVENT path has already linked them.  This is deliberately a list
+ * move only: the function instance and its lifetime remain unchanged. */
+static void promote_linked_uac2_function(struct gadget_info *gi,
+		struct config_usb_cfg *cfg)
+{
+	struct usb_function *f, *tmp;
+
+	list_for_each_entry_safe(f, tmp, &gi->linked_func, list) {
+		if (!strcmp(f->name, "uac2_func"))
+			list_move_tail(&f->list, &cfg->func_list);
+	}
+}
 static int make_adb_connection_for_gsi(
 	struct config_usb_cfg *cfg,
 	struct usb_function_instance *fi)
@@ -1567,6 +1581,10 @@ static int configfs_composite_bind(struct usb_gadget *gadget,
 		struct config_usb_cfg *cfg;
 
 		cfg = container_of(c, struct config_usb_cfg, c);
+#ifdef CONFIG_USB_CONFIGFS_UEVENT
+		/* Cover direct UDC rebind where functions_store() was not called. */
+		promote_linked_uac2_function(gi, cfg);
+#endif
 		if (list_empty(&cfg->func_list)) {
 			pr_err("Config %s/%d of %s needs at least one function.\n",
 			      c->label, c->bConfigurationValue,
@@ -2011,6 +2029,13 @@ functions_store(struct device *pdev, struct device_attribute *attr,
 		}
 	}
 
+	/* Vendor functions_store("adb") must not strand an already linked UAC2
+	 * function in linked_func; promote it after the requested functions. */
+	list_for_each_entry(c, &cdev->configs, list) {
+		cfg = container_of(c, struct config_usb_cfg, c);
+		promote_linked_uac2_function(dev, cfg);
+	}
+
 	mutex_unlock(&dev->lock);
 
 	return size;
