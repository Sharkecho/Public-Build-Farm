--- a/mud/mud.c
+++ b/mud/mud.c
@@ -1578,6 +1578,26 @@
     return mud->window < 1500;
 }
 
+/* ---- MT3000 patch: redundant (Speedify-style) send mode -------------------
+ * When MUD_REDUNDANT=1 every IP packet is transmitted on all healthy paths
+ * instead of the single scheduler-selected one. The receiver's reorder buffer
+ * already keys on the packet sequence number, so the duplicate copies are
+ * dropped there. Cost: 2x tunnel bandwidth. Benefit: no path switch, no
+ * reordering stall 鈥?whichever copy arrives first is the one that counts.
+ */
+static int
+mud_redundant_enabled(void)
+{
+    static int cached = -1;
+
+    if (cached < 0) {
+        const char *env = getenv("MUD_REDUNDANT");
+        cached = (env && env[0] == '1') ? 1 : 0;
+    }
+
+    return cached;
+}
+
 int
 mud_send(struct mud *mud, const void *data, size_t size)
 {
@@ -1611,5 +1631,18 @@
 
     path->idle = now;
 
-    return mud_send_path(mud, path, now, packet, packet_size, 0);
+    int ret = mud_send_path(mud, path, now, packet, packet_size, 0);
+
+    if (mud_redundant_enabled()) {
+        for (unsigned i = 0; i < mud->count; i++) {
+            struct mud_path *alt = &mud->paths[i];
+
+            /* Judge a leg by its state and MTU, not by its `ok` flag.
+             *
+             * `ok` is cleared at the top of every mud_update() tick and set
+             * again only when that leg's probe messages are being answered:
+             *
+             *     if (path->msg.sent >= MUD_MSG_SENT_MAX) { ... }  <- no ok
+             *     else if (mud_path_is_ok(mud, path)) path->ok = 1;
+             *
+             * A leg whose carrier NAT mapping is lossy sits at msg.sent == 5
+             * permanently, so its `ok` never becomes 1 and duplication skips it
+             * for ever. Measured 2026-10-24 on the iPhone leg: state UP, mtu.ok
+             * 1472, tx.loss 0, yet path->ok == 0 (printed as DEGRADED) and the
+             * eth0:eth2 packet ratio was 11.7:1 instead of 1:1.
+             *
+             * That leg is precisely why redundancy exists: its probes are
+             * unreliable, its data path still carries packets. Sending the copy
+             * anyway costs bandwidth when the leg is dead, but the receiver
+             * dedups, so it can never cost correctness.
+             */
+            if (alt == path)
+                continue;
+
+            if (alt->state < MUD_UP || !alt->mtu.ok)
+                continue;
+
+            mud_send_path(mud, alt, now, packet, packet_size, 0);
+        }
+    }
+
+    return ret;
 }
